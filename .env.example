PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# Comma-separated origins allowed by CORS (the frontend dev server, e.g. http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000

# Access token: short-lived, sent as "Authorization: Bearer <token>" on every request
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token: long-lived, only used to mint new access tokens via /refresh-token
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key
REFRESH_TOKEN_EXPIRES_IN=30d
